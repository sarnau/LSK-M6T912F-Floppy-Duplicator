# Normalize line endings for text files (checked in as LF)
* text=auto eol=lf

# --- Binary assets: never diff/merge as text ---
*.bin  binary
*.pdf  binary
*.PDF  binary
*.jpg  binary
*.jpeg binary
*.png  binary

# --- Disassembler output ---
# Count the listing as Assembly in the language stats (force the language so
# it isn't mis-detected); keep the symbol map out of the stats.
disassembly/sourcecode.s linguist-language=Assembly linguist-detectable=true
disassembly/symbols.txt  linguist-generated=true
disassembly/inline_comments.py linguist-generated=true

# --- Standalone analysis pages are documentation, not source ---
*.html linguist-documentation=true
